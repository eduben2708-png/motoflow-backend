# Puerto del servidor
PORT=5000

# Configuración de MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=motocourier
DB_PORT=3306

# Claves VAPID para las notificaciones push (avisan al repartidor de un
# pedido nuevo aunque tenga la app cerrada o el celular bloqueado). Se
# generan una sola vez; ver instrucciones para crearlas si hace falta
# reemplazarlas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bloqueo de horario de atención (07:30 a 17:30, hora de Paraguay). En
# "false" (o sin definir) no se bloquea nada, para poder probar a cualquier
# hora. Poner en "true" recién cuando se lance la app de verdad.
HORARIO_ATENCION_ACTIVO=false